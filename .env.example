# Example environment for amass-docker-compose.
# Copy to .env and fill in real values; .env itself is gitignored.

# Change Me!
POSTGRES_PASSWORD=changeme
AMASS_DB=assetdb
AMASS_USER=amass
# Change Me!
AMASS_PASSWORD=changeme
AMASS_AI_LOCAL_AMASS=../amass
AMASS_AI_ALLOW_HTTP=true

AMASS_AI_PROVIDER=ollama
AMASS_AI_ENDPOINT=http://host.docker.internal:11434

AMASS_AI_ATTRIBUTION=journal
AMASS_DB_STATS=1
