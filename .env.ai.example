# Copy the model-related lines into the local (untracked) .env, or export
# them in the shell. Do not overwrite the existing POSTGRES/AMASS credentials.
# This is development/test configuration, not a production secret store.

AMASS_AI_IMAGE=amass-ai:dev
AMASS_AI_AMASS_REF=feature/ai-investigation-inference
AMASS_AI_ASSETDB_REF=feature/ai-investigation-inference
# Build Amass from a local checkout instead (see AI.md):
# AMASS_AI_LOCAL_AMASS=../amass
# Native Ollama API (recommended). For the OpenAI-compatible API instead use
# AMASS_AI_PROVIDER=compatible and AMASS_AI_ENDPOINT=http://ollama:11434/v1/chat/completions
AMASS_AI_PROVIDER=ollama
AMASS_AI_ENDPOINT=http://ollama:11434
# Qwen3 thinking is slow on CPU-only Docker Desktop; leave off unless needed.
AMASS_AI_THINK=false
AMASS_AI_CONTEXT_TOKENS=8192
AMASS_AI_MODEL=qwen3:8b
# Pinned Ollama runtime for the ai-local profile; override to upgrade.
AMASS_AI_OLLAMA_IMAGE=ollama/ollama:0.40.15
# scripts/ai-up.sh opts into HTTP only for the trusted internal Ollama hostname.
AMASS_AI_ALLOW_HTTP=false
AMASS_AI_MODEL_TIMEOUT=4m
AMASS_AI_INVESTIGATION_TIMEOUT=12m
# Classifier is a separate, always-on provider-neutral service:
AMASS_AI_CLASSIFIER_ENDPOINT=http://classifier:8092
AMASS_AI_CLASSIFIER_REVIEW=true
# Mount optional trained artifact: data/models/classifier.json
# Or supply curated data in data/classifier-training/labeled.jsonl,
# and scripts/ai-up.sh will train a model before service startup.
AMASS_AI_MCP_PORT=18090
# MCP token is auto-generated in data/ai/.mcp-token by scripts/ai-up.sh.
# You may instead export AMASS_AI_MCP_TOKEN from a secret manager.
# If switching to a hosted model, use HTTPS and an approved key source:
# AMASS_AI_API_KEY=<set outside the repo>

# Linux bind-mount ownership: use the output of `id -u`/`id -g`.
# Default non-root image user is 1000:1000. Mac Docker Desktop users
# can generally leave these defaults unchanged.
# AMASS_AI_UID=1000
# AMASS_AI_GID=1000

# Isolated Docker Compose test deployment: ensure these identifiers/ports
# are unused on the Docker host.
# AMASS_TEST_NAMESPACE=amass-ai-test
# AMASS_TEST_DB_PORT=55433
# AMASS_TEST_NEO4J_HTTP_PORT=17474
# AMASS_TEST_NEO4J_BOLT_PORT=17687
