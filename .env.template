# PostgreSQL root password (not required when DB_SERVER=sqlite)
POSTGRES_PASSWORD=postgres # Change Me!
# Amass database backend: postgres (default), neo4j, sqlite
# sqlite  — no external database required; data stored in ./data/engine/assetdb.db
#           start with: docker compose up -d
# postgres — requires the bundled assetdb service
#           start with: COMPOSE_PROFILES=postgres docker compose up -d
# neo4j   — requires the bundled neo4j service
#           start with: COMPOSE_PROFILES=neo4j docker compose up -d
DB_SERVER=postgres
# Activate the matching database service (set to postgres, neo4j, or leave unset for sqlite)
#COMPOSE_PROFILES=postgres
AMASS_DB=assetdb
AMASS_USER=amass
AMASS_PASSWORD=amass4OWASP # Change Me!
# Log level for engine and all client containers: INFO (default), WARN, ERROR, DEBUG
#AMASS_LOGLEVEL=INFO
