
# ── Database ──────────────────────────────────────────────────────────────────
#
# Select the database backend by setting COMPOSE_PROFILES.
# The profile starts the matching service AND configures config.yaml.
#
#   (unset)  SQLite    — no credentials required
#                        docker compose up -d
#
#   postgres PostgreSQL — credentials required (see below)
#                        docker compose up -d
#
#   neo4j    Neo4j      — credentials required (see below)
#                        docker compose up -d
#
# Multiple profiles are comma-separated, e.g.: COMPOSE_PROFILES=postgres,mcp
#
# PostgreSQL is selected by default. Change or comment out to switch backends.
COMPOSE_PROFILES=postgres

# ── Logging ───────────────────────────────────────────────────────────────────
#
# Log level for engine and all client containers.
# Valid values: INFO (default), WARN, ERROR, DEBUG
#
#AMASS_LOGLEVEL=INFO

# ── Database credentials ── Change these before use! ─────────────────────────
#
# Required when COMPOSE_PROFILES includes postgres or neo4j.
# Not used for SQLite.
#
AMASS_DB=assetdb
AMASS_USER=amass

POSTGRES_PASSWORD=ChangeMe!
AMASS_PASSWORD=ChangeMe!
